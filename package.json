{
	"dependencies": {
		"@evenrealities/pretext": "^0.1.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"even-toolkit": "^1.5.0",
		"hono": "^4.12.9",
		"lucide-react": "^1.16.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.13.2",
		"tailwind-merge": "^3.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260329.1",
		"@evenrealities/even_hub_sdk": "^0.0.10",
		"@evenrealities/evenhub-cli": "^0.1.12",
		"@evenrealities/evenhub-simulator": "^0.7.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.1.2",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.19.3",
		"typescript": "~5.0.0",
		"vite": "^8.0.3",
		"wrangler": "^4.77.0"
	},
	"name": "birdie-even",
	"private": true,
	"scripts": {
		"build": "tsc && vite build",
		"build:prod": "tsc && vite build --mode prod",
		"deploy:birdnet": "bash ./birdnet-server/deploy.sh",
		"dev": "concurrently -n QR,VITE,SERVER -c cyan,green,yellow \"npm run qr\" \"vite --host 0.0.0.0 --port 5173\" \"npm run server\"",
		"emulator": "npx evenhub-simulator http://localhost:5173/ --aid alsa:pipewire",
		"pack": "npm run build:prod && evenhub pack app.json dist -o birdie.ehpk",
		"qr": "node ../../scripts/qr.mjs",
		"server": "wrangler dev --port 3001 --ip 0.0.0.0",
		"typecheck": "tsc --noEmit"
	},
	"type": "module"
}
