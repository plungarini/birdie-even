# Worker endpoint (HTTPS). Swap for your deployed worker URL.
VITE_WORKER_URL=https://xxx.xxx.workers.dev

# Audio capture window sent to BirdNET, in milliseconds.
# MUST be >= VITE_MIN_CHUNK_DURATION_MS and <= VITE_MAX_CHUNK_DURATION_MS.
VITE_CHUNK_DURATION_MS=5000

# Hard bounds enforced at startup. Do not lower MIN below 4000 —
# BirdNET needs at least one full 3s analysis window plus headroom.
VITE_MIN_CHUNK_DURATION_MS=4000
VITE_MAX_CHUNK_DURATION_MS=60000

# Minimum confidence to display (0.0 – 1.0). Detections below this
# are ignored by the HUD renderer.
VITE_MIN_CONFIDENCE=0.4
